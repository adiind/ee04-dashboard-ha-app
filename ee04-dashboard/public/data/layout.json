        {
          "id": "climate-humidity-sensors",
          "type": "entityList",
          "slot": "humidity",
          "label": "Humidity",
          "binding": {
            "kind": "preset",
            "preset": "climate.humiditySensors"
          },
          "options": {
            "icon": "Droplets",
            "limit": 5,
            "emptyLabel": "No extra humidity sensors"
          }
        }
