{
  "version": 1,
  "pages": [
    {
      "id": "home",
      "label": "Home",
      "phrase": "now / next",
      "enabled": true,
      "template": "home-grid",
      "widgets": [
        {
          "id": "home-weather",
          "type": "weatherHero",
          "slot": "hero",
          "binding": {
            "kind": "preset",
            "preset": "weather"
          },
          "options": {
            "eyebrow": "Weather",
            "icon": "CloudSun",
            "showRange": true
          }
        },
        {
          "id": "home-mood",
          "type": "statusStrip",
          "slot": "mood",
          "binding": {
            "kind": "preset",
            "preset": "home.mood"
          },
          "options": {
            "variant": "mood",
            "icon": "CheckCircle2",
            "eyebrow": "House Signal"
          }
        },
        {
          "id": "home-tiles",
          "type": "statTile",
          "slot": "tiles",
          "binding": {
            "kind": "preset",
            "preset": "home.tiles"
          },
          "options": {
            "columns": 1,
            "tiles": [
              {
                "preset": "home.tiles.indoor",
                "icon": "Thermometer",
                "label": "Indoor",
                "tone": "red"
              },
              {
                "preset": "home.tiles.lights",
                "icon": "Lightbulb",
                "label": "Lights",
                "tone": "yellow"
              },
              {
                "preset": "home.tiles.presence",
                "icon": "Users",
                "label": "Presence",
                "tone": "green"
              },
              {
                "preset": "home.tiles.battery",
                "icon": "Battery",
                "label": "Low Bat",
                "tone": "blue"
              }
            ]
          }
        },
        {
          "id": "home-agenda",
          "type": "agendaList",
          "slot": "agenda",
          "label": "Next",
          "binding": {
            "kind": "preset",
            "preset": "agenda"
          },
          "options": {
            "variant": "simple",
            "limit": 3,
            "icon": "CalendarDays",
            "emptyLabel": "No calendar items"
          }
        }
      ]
    },
    {
      "id": "rooms",
      "label": "Lights",
      "phrase": "rooms / signals",
      "enabled": true,
      "template": "rooms-grid",
      "widgets": [
        {
          "id": "rooms-command",
          "type": "statusStrip",
          "slot": "command",
          "label": "Light Load",
          "binding": {
            "kind": "preset",
            "preset": "rooms.command"
          },
          "options": {
            "variant": "roomCommand",
            "icon": "LayoutGrid"
          }
        },
        {
          "id": "rooms-active-lights",
          "type": "entityList",
          "slot": "lights",
          "label": "On Right Now",
          "binding": {
            "kind": "preset",
            "preset": "lights.active"
          },
          "options": {
            "icon": "Lightbulb",
            "limit": 6,
            "emptyLabel": "All lights off"
          }
        },
        {
          "id": "rooms-signal",
          "type": "entityList",
          "slot": "signal",
          "binding": {
            "kind": "preset",
            "preset": "rooms.signal"
          },
          "options": {
            "variant": "printerOrUnavailable",
            "iconPrimary": "Printer",
            "iconFallback": "Router",
            "labelPrimary": "Printer",
            "labelFallback": "Device Watch",
            "limit": 4,
            "emptyLabel": "All key signals reachable"
          }
        },
        {
          "id": "rooms-status",
          "type": "statusStrip",
          "slot": "status",
          "label": "Room Pulse",
          "tone": "yellow",
          "binding": {
            "kind": "preset",
            "preset": "rooms.status"
          },
          "options": {
            "variant": "roomStatus",
            "icon": "Radio"
          }
        }
      ]
    },
    {
